<?xml version='1.0' encoding='UTF-8'?>
<GenRoBag>
  <instance_name>demohotel</instance_name>

  <!-- Database Configuration -->
  <db_dbname>demohotel</db_dbname>
  <db_host>localhost</db_host>
  <db_port>5432</db_port>
  <db_user>postgres</db_user>
  <db_password></db_password>
  <db_implementation>postgresql</db_implementation>

  <!-- Packages -->
  <packages>
    <sys/>
    <adm/>
    <glbl/>
    <host/>
  </packages>

  <!-- Instance Settings -->
  <wsgi_port>8090</wsgi_port>
  <wsgi_debug>True</wsgi_debug>
  <wsgi_reload>True</wsgi_reload>

  <!-- Locale -->
  <default_language>it</default_language>
  <available_languages>it,en</available_languages>
</GenRoBag>
